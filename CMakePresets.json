{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "clang",
      "displayName": "Clang (Ninja, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang-reldbg",
      "displayName": "Clang (Ninja, RelWithDebInfo)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang-reldbg",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "gcc",
      "displayName": "GCC (Ninja, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "clang", "configurePreset": "clang" },
    { "name": "clang-reldbg", "configurePreset": "clang-reldbg" },
    { "name": "gcc", "configurePreset": "gcc" }
  ],
  "testPresets": [
    { "name": "clang", "configurePreset": "clang", "output": { "outputOnFailure": true } },
    { "name": "clang-reldbg", "configurePreset": "clang-reldbg", "output": { "outputOnFailure": true } },
    { "name": "gcc", "configurePreset": "gcc", "output": { "outputOnFailure": true } }
  ]
}
