/* Sky Hopper's theme: cloud islands. Every screen floats in the game's blue sky on white cloud
 * cards with a sky-blue edge and a soft drop shadow; headlines are the deep blue of the zenith, the
 * main button and whatever a key or pad has focused are coin gold (focus as loud as hover: the
 * menus are driven by keys and pads), and the final win is edged in gold. A
 * project theme replaces the engine's built-in sheet, so the screens carry classes, not colours.
 *
 * The palette (written out where used: var() does not reach inside a drawable's arguments):
 * cloud #FFFFFF, mist #EAF4FF, sky #4DA3EE, deep sky #1F5FAF, ink #233249, soft ink #5A6B85,
 * coin gold #FFC93C (deep gold #D99A00). */

/* The icons (UI/Icons/*, vector images drawn by this project; the theme's cook embeds them). */
@icon heart "{c1e3a2f2-ed4e-4765-886f-d5fd8d2776fd}";
@icon coin "{8286b06a-7c3d-4a38-a303-c8e96991d0b9}";
@icon star "{6faf9764-c33a-444f-8126-91cc8eade4f5}";
@icon star-empty "{8d152545-e14d-443f-9450-6c41b0765988}";
@icon clock "{61312858-e1db-4148-952a-29b440b6cd66}";
@icon gem "{1cb0b016-e4eb-4605-ab11-4a30fc6aa89c}";

Label { text-color: #233249; }

/* An icon is a sized Panel with one of these: the SVG keeps its own colours. */
.icon-heart { background: svg(heart); }
.icon-coin { background: svg(coin); }
.icon-star { background: svg(star); }
.icon-star-empty { background: svg(star-empty); }
.icon-clock { background: svg(clock); }
.icon-gem { background: svg(gem); }

/* ---- the sky behind a screen, and the clouds on it ---- */

.veil { background: rgba(31, 95, 175, 0.25); }
.veil-heavy { background: rgba(31, 95, 175, 0.45); }

.cloud {
	background: rounded-rect(#FFFFFF, radius=24, border=#4DA3EE, border-width=3);
	box-shadow: 0 6 16 rgba(31, 95, 175, 0.35);
}
.cloud-gold {
	background: rounded-rect(#FFFFFF, radius=24, border=#FFC93C, border-width=4);
	box-shadow: 0 6 16 rgba(217, 154, 0, 0.4);
}

.headline { text-color: #1F5FAF; }
.headline-gold { text-color: #D99A00; }
.body { text-color: #233249; }
.note { text-color: #5A6B85; }
/* The game's name over the sky: coin gold, which reads on blue. */
.title { text-color: #FFC93C; }
.over-sky { text-color: #FFFFFF; }

/* ---- buttons: cloud pills with a sky edge; the main one coin gold ---- */

ButtonBase {
	background: state-list(
		normal=rounded-rect(#FFFFFF, radius=22, border=#4DA3EE, border-width=2),
		hover=rounded-rect(#EAF4FF, radius=22, border=#1F5FAF, border-width=3),
		pressed=rounded-rect(#D6E9FF, radius=22, border=#1F5FAF, border-width=3),
		focused=rounded-rect(#FFE58A, radius=22, border=#1F5FAF, border-width=3),
		disabled=rounded-rect(#EEF2F7, radius=22, border=#B5C2D3, border-width=2)
	);
	box-shadow: 0 3 8 rgba(31, 95, 175, 0.3);
	text-color: #1F5FAF;
	font-size: 20;
	padding: 6 18;
	corner-radius: 22;
}

.primary {
	background: state-list(
		normal=rounded-rect(#FFC93C, radius=22, border=#D99A00, border-width=2),
		hover=rounded-rect(#FFD766, radius=22, border=#D99A00, border-width=3),
		pressed=rounded-rect(#F2B416, radius=22, border=#B57F00, border-width=3),
		focused=rounded-rect(#FFC93C, radius=22, border=#1F5FAF, border-width=4),
		disabled=rounded-rect(#E9D9A8, radius=22, border=#C9B276, border-width=2)
	);
	box-shadow: 0 3 8 rgba(181, 127, 0, 0.45);
	text-color: #233249;
}

/* ---- the settings' volume sliders: a misty groove, a sky fill, a cloud thumb ---- */

Slider::track { background: rounded-rect(#EAF4FF, radius=5, border=#4DA3EE, border-width=2); height: 10; }
Slider::fill { background: rounded-rect(#4DA3EE, radius=5); }
Slider::thumb {
	background: state-list(
		normal=rounded-rect(#FFFFFF, radius=12, border=#1F5FAF, border-width=2),
		hover=rounded-rect(#EAF4FF, radius=12, border=#1F5FAF, border-width=3),
		focused=rounded-rect(#FFC93C, radius=12, border=#1F5FAF, border-width=3),
		disabled=rounded-rect(#EEF2F7, radius=12, border=#B5C2D3, border-width=2)
	);
	width: 24;
}

/* ---- the HUD: a cloud pill at the top of the sky ---- */

.hud {
	background: rounded-rect(#FFFFFF, radius=20, border=#4DA3EE, border-width=3);
	box-shadow: 0 4 10 rgba(31, 95, 175, 0.3);
}
.hud-coins { text-color: #D99A00; }
.hud-value { text-color: #233249; }
.hud-dim { text-color: #5A6B85; }
.hud-level { text-color: #1F5FAF; }
.hud-score { text-color: #1F5FAF; }
/* A gain floating up from the score or a counter: gold edged in the deep sky, readable over
 * sky and grass alike. */
.popup { text-color: #FFC93C; }
.popup-life { text-color: #EF4444; }

/* ---- the level clear tally ---- */
.tally-name { text-color: #5A6B85; }
.tally-value { text-color: #233249; }
.tally-total { text-color: #1F5FAF; }
.best { text-color: #D99A00; }
.rule { background: rounded-rect(#4DA3EE, radius=1); }
