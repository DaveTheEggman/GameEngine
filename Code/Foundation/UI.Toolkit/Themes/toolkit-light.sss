/* toolkit-light.sss - toolkit-control styling, LIGHT branch (ui-theme-migration.md P3).
 * FAITHFUL transcription of ToolkitThemeExtension::Apply's !isDark rules, parity-gated
 * (ToolkitThemeParityTests) against the legacy C++ body. The extension picks this fragment
 * when the palette reads light (background luminance at or above half). Light chrome darkens
 * the surface where dark chrome darkens harder or lightens - the derived directions differ
 * per control, which is why this is a separate sheet and not a variable swap.
 */

/* === DockManager === */
DockManager { background: color($background); }

/* === DockablePanel === */
DockablePanel {
    text-color: $text;
    background: color($surface);
}
DockablePanel::header { background: rounded-rect(darken($surface, 5%), radius=0); }
DockablePanel::content { background: color($surface); }
DockablePanel::close-button { text-color: alpha($text, 0.5882353); }
DockablePanel::close-button:hover { text-color: $error; }

/* === DockTabGroup === */
DockTabGroup {
    border-color: $border;
    accent-color: $primary-accent;
    /* Compact tab-strip text (a specific size so the 24px strip doesn't inherit the global
     * 16px default); wins over the View default via CSS last-declared tie-break. */
    font-size: 12;
}
DockTabGroup::strip { background: color(darken($surface, 8%)); }
DockTabGroup::content { background: color($surface); }
DockTabGroup::tab { text-color: alpha($text, 0.6); }
/* rounded-rect (radius 0) so DockTabGroup can mask tab top corners to the theme's resolved
 * CornerRadius. */
DockTabGroup::tab:checked {
    background: rounded-rect(lighten($surface, 3%), radius=0);
    text-color: $text;
}
DockTabGroup::tab:hover {
    background: rounded-rect(darken($surface, 4%), radius=0);
    text-color: lighten(alpha($text, 0.6), 30%);
}
DockTabGroup::close-button { text-color: alpha($text, 0.6); }
DockTabGroup::close-button:hover { text-color: $error; }

/* === DockSplit === */
DockSplit {
    border-color: darken($surface, 10%);
    accent-color: darken($surface, 20%);
}

/* === DockableWindow === */
DockableWindow { background: rounded-rect($surface, radius=0, border=$border, border-width=1); }

/* === MenuBar === */
MenuBar {
    background: color($surface);
    text-color: $text;
    border-color: $border;
    /* Muted translucent accent for whole-item hover fills (see toolkit-dark.sss). 55/255. */
    accent-color: alpha($primary-accent, 0.2156863);
}

/* === Toolbar === */
Toolbar {
    background: color(darken($surface, 5%));
    border-color: $border;
    selection-color: lighten($primary-accent, 30%);
}

/* === StatusBar === */
StatusBar {
    background: color(darken($surface, 5%));
    border-color: $border;
    text-color: $text;
}

/* === SplitView === */
SplitView {
    border-color: darken($surface, 10%);
    accent-color: darken($surface, 20%);
    text-dim-color: alpha($text-dim, 0.7058824);
}

/* === BreadcrumbBar === (rounded-rect so it can round to the theme CornerRadius) */
BreadcrumbBar {
    background: rounded-rect($surface, radius=0);
    text-color: $text;
    accent-color: $primary-accent;
}

/* === ColorPicker === */
ColorPicker {
    background: color($surface);
    border-color: $border;
}

/* === PropertyGrid === */
PropertyGrid {
    background: color($surface);
    border-color: $border;
}

/* === ToastCard === (background-color: raw color for ResolveStyleColor - see toolkit-dark.sss) */
ToastCard {
    background-color: $surface-bright;
    text-color: $text;
}
