/* light.sss - the built-in light theme (ui-theme-migration.md P2).
 * FAITHFUL transcription of the former LightTheme.cppm rule set, parity-gated
 * (ThemeParityTests) before the C++ body dies. Icons use the DARK tint through the
 * shared ThemeIconSet tinted-variant cache (svg(name, tint=...) - the P0 fallback).
 */

/* === Global defaults === */
View {
    text-color: $text;
    font-size: 16;
}

/* === Button === */
ButtonBase {
    background: state-colors(#dcdee6);
    checked-background: state-colors($primary-accent);
    text-color: #1e1e28;
    padding: 8 12;  /* CSS order: vertical horizontal (= C++ Thickness{12,8}) */
    corner-radius: 0;
}

/* === Panel === */
.panel {
    background: rounded-rect($surface, radius=0, border=$border, border-width=1);
}

/* === Label === */
.label { text-color: $text; }
.label-dim { text-color: $text-dim; }

/* === EditText === */
EditText {
    background: rounded-rect($surface, radius=0, border=$border, border-width=1);
    text-color: $text;
    placeholder-color: $text-dim;
    font-size: 14;
    padding: 4 6;   /* CSS order: vertical horizontal (= C++ Thickness{6,4}) */
    cursor-color: $primary-accent;
    selection-color: #3c78c83c;
}

/* === NumericField === */
NumericField {
    background: rounded-rect($surface, radius=0, border=$border, border-width=1);
    text-color: $text;
    placeholder-color: $text-dim;
    font-size: 14;
    padding: 4 6;   /* CSS order: vertical horizontal (= C++ Thickness{6,4}) */
    cursor-color: $primary-accent;
    selection-color: #3c78c83c;
}
NumericField::spin-up { background: state-colors(darken($surface, 8%)); }
NumericField::spin-down { background: state-colors(darken($surface, 8%)); }

/* === CheckBox === */
CheckBox::box {
    background: rounded-rect($surface, radius=0, border=$border, border-width=1);
    width: 18;
}
CheckBox::box:checked {
    background: rounded-rect($primary-accent, radius=0, border=$border, border-width=1);
}
CheckBox { spacing: 6; }

/* === RadioButton === */
RadioButton::box {
    background: rounded-rect($surface, radius=0, border=$border, border-width=1);
}
RadioButton::box:checked {
    background: rounded-rect($primary-accent, radius=0, border=$border, border-width=1);
}

/* === Slider === */
Slider::track { background: color(#d2d7e1); height: 4; }
Slider::fill { background: color($primary-accent); }
Slider::thumb { background: color($primary-accent); width: 16; }

/* === ProgressBar === */
ProgressBar::track { background: color(#d2d7e1); }
ProgressBar::fill { background: color($primary-accent); }

/* === ToggleSwitch === */
ToggleSwitch::track {
    background: rounded-rect(#c8cdd7, radius=0, border=$border, border-width=1);
}
ToggleSwitch::track:checked {
    background: rounded-rect($primary-accent, radius=0, border=$border, border-width=1);
}
ToggleSwitch::knob { background: color($surface); }

/* === ComboBox === */
ComboBox {
    background: rounded-rect($surface, radius=0, border=$border, border-width=1);
}
ComboBox::arrow { text-color: #505564; }

/* === ScrollBar === */
ScrollBar::track { background: color(#e6e8f096); }
ScrollBar::thumb { background: color(#a0a5b4c8); }

/* === Separator === */
Separator { border-color: $border; }

/* === Expander === */
Expander::header { background: color(#ebeef5); }
Expander::header:hover { background: color(darken(#ebeef5, 5%)); }
Expander::chevron { text-color: #505564; }

/* === TabView === */
TabView::strip { background: color(darken($surface, 5%)); }
TabView::content { background: color($surface); }
TabView::tab:checked { background: color($surface); }
TabView::tab:hover { background: color(darken($surface, 3%)); }
TabView::tab { text-color: $text-dim; }
TabView::tab:checked { text-color: $text; }
TabView::tab:hover { text-color: darken($text-dim, 20%); }
TabView::close-button { text-color: $text-dim; width: 12; }
TabView::close-button:hover { text-color: $text; }
TabView {
    border-color: $border;
    accent-color: $primary-accent;
}

/* === ContextMenu === */
.contextmenu {
    background: rounded-rect($surface, radius=0, border=$border, border-width=1);
    menu-item-hover-drawable: rounded-rect(#3c78c83c, radius=0);
    text-color: $text;
    border-color: $border;
    accent-color: #3c78c83c;
}

/* === Dialog === */
Dialog {
    background: rounded-rect($surface, radius=0, border=$border, border-width=1);
}

/* === Tooltip === */
TooltipView {
    background: rounded-rect(#ffffe1f5, radius=0, border=#b4af8c, border-width=1);
    text-color: $text;
}

/* === ListView / TreeView / GridView === */
ListView {
    background: color($background);
    selection-color: #3c78c83c;
}
TreeView { background: color($background); }
GridView {
    background: color($background);
    selection-color: #3c78c83c;
}

/* === Icons (DARK tint for the light theme; shared tinted baked instances) === */
CheckBox::checkmark { background: svg(checkmark, tint=#3c3c46); }
RadioButton::mark { background: svg(radio-mark-square, tint=#3c3c46); }
TabView::close-button { background: svg(close, tint=#3c3c46); }
Expander::chevron:checked { background: svg(chevron-down, tint=#3c3c46); }
Expander::chevron { background: svg(chevron-right, tint=#3c3c46); }
TreeView::chevron:checked { background: svg(chevron-down, tint=#3c3c46); }
TreeView::chevron { background: svg(chevron-right, tint=#3c3c46); }
.contextmenu::submenu-arrow { background: svg(chevron-right, tint=#3c3c46); }
ComboBox::arrow { background: svg(arrow-down, tint=#3c3c46); }
NumericField::arrow-up { background: svg(arrow-up, tint=#3c3c46); }
NumericField::arrow-down { background: svg(arrow-down, tint=#3c3c46); }
